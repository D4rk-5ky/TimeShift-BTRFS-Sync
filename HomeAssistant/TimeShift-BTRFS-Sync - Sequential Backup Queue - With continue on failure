                entity_id: switch.jonsbo_n3_cwwk_n355_10gbe_nas_2
                state: 'on'
        then:
          - alias: Wait up to 20 minutes for Jonsbo N3
            wait_for_trigger:
              - trigger: state
                entity_id: switch.jonsbo_n3_cwwk_n355_10gbe_nas_2
                to: 'on'
            timeout: '00:20:00'
            continue_on_timeout: true
      - alias: Run Jonsbo N3 backup only if machine is online
        if:
          - condition: state
            entity_id: switch.jonsbo_n3_cwwk_n355_10gbe_nas_2
            state: 'on'
        then:
          - delay:
              hours: 0
              minutes: 5
              seconds: 0
              milliseconds: 0
          - alias: 'OPTIONAL: Fixed boot delay when Ping is not used'
            enabled: false
            delay: '00:05:00'
          - alias: Start Jonsbo N3 backup
            action: mqtt.publish
            continue_on_error: true
            data:
              evaluate_payload: false
              qos: 0
              retain: false
              topic: homeassistant/mqtt-listener/asusn14e
              payload: timeshift-jonsbo-n3
          - alias: Wait for Jonsbo N3 backup result
            wait_for_trigger:
              - trigger: mqtt
                topic: homeassistant/timeshift-btrfs-sync/JonsBo-N3/status
            timeout: '12:00:00'
            continue_on_timeout: true
          - alias: Read Jonsbo N3 backup result
            variables:
              backup_status: |-
                {% if wait.trigger is none %}
                  timeout
                {% elif wait.trigger.payload_json is defined %}
                  {{ wait.trigger.payload_json.status
                     | default('unknown')
                     | string
                     | lower }}
                {% else %}
                  {{ wait.trigger.payload
                     | default('unknown')
                     | string
                     | lower }}
                {% endif %}
          - alias: Handle Jonsbo N3 backup result
            choose:
              - conditions:
                  - condition: template
                    value_template: |-
                      {{ backup_status in
                         ['success', 'successful', 'ok',
                          'complete', 'completed'] }}
                sequence:
                  - alias: Report Jonsbo N3 backup success
                    action: notify.pushover
                    continue_on_error: true
                    data:
                      title: ✅ Backup completed - Jonsbo N3
                      message: |-
                        Jonsbo N3 Timeshift backup completed successfully.
                        The queue will continue with the next backup.
                      data:
                        priority: 0
                        sound: pushover
              - conditions:
                  - condition: template
                    value_template: |-
                      {{ backup_status in
                         ['failure', 'failed', 'fail', 'error'] }}
                sequence:
                  - alias: Report Jonsbo N3 backup failure
                    action: notify.pushover
                    continue_on_error: true
                    data:
                      title: ❌ Backup failed - Jonsbo N3
                      message: |-
                        Jonsbo N3 reported backup status: {{ backup_status }}.
                        The queue will continue with the next backup.
                      data:
                        priority: 0
                        sound: pushover
              - conditions:
                  - condition: template
                    value_template: '{{ backup_status == ''timeout'' }}'
                sequence:
                  - alias: Report Jonsbo N3 backup timeout
                    action: notify.pushover
                    continue_on_error: true
                    data:
                      title: ⚠️ Backup timed out - Jonsbo N3
                      message: |-
                        Jonsbo N3 did not report an MQTT result within 12 hours.
                        The queue will continue with the next backup.
                      data:
                        priority: 0
                        sound: pushover
              - conditions:
                  - condition: template
                    value_template: |-
                      {{ backup_status not in
                         ['success', 'successful', 'ok',
                          'complete', 'completed',
                          'failure', 'failed', 'fail', 'error',
                          'timeout'] }}
                sequence:
                  - alias: Report unknown Jonsbo N3 result
                    action: notify.pushover
                    continue_on_error: true
                    data:
                      title: ⚠️ Unknown backup result - Jonsbo N3
                      message: |-
                        Jonsbo N3 returned the MQTT status: {{ backup_status }}.
                        The queue will continue with the next backup.
                      data:
                        priority: 0
                        sound: pushover
        else:
          - alias: Report skipped Jonsbo N3 backup
            action: notify.pushover
            continue_on_error: true
            data:
              title: ⚠️ Backup skipped - Jonsbo N3
              message: >-
                Jonsbo N3 did not become available within 20 minutes.

                Its backup has been skipped and the queue will continue with the
                next machine.
              data:
                priority: 0
                sound: pushover
      - alias: Delay before next backup
        delay: '00:01:00'
    continue_on_error: true
  - alias: Report completed backup queue
    action: notify.pushover
    continue_on_error: true
    data:
      title: ✅ Backup queue completed
      message: >-
        The sequential backup queue has finished.

        All enabled backup jobs were attempted.

        A failed backup, offline machine, unknown MQTT result, or MQTT timeout
        does not prevent the remaining backup jobs from being attempted.
      data:
        priority: 0
        sound: pushover
mode: single
max_exceeded: warning
