alias: TimeShift-BTRFS-Sync - Sequential Backup Queue - With continue on failure
description: >-
  Starts each Timeshift BTRFS backup sequentially. If a machine does not come
  online within 20 minutes, only that machine is skipped. Each backup reports
  success, failure, timeout, or unknown status individually through Pushover.
  Regardless of the result, the queue continues with the next enabled machine.
triggers:
  - trigger: time
    at: sensor.daily_backup_cheapest_start
    id: cheapest_start
    weekday:
      - fri
    enabled: false
  - trigger: mqtt
    id: zotac_backup_sequence_complete
    options:
      topic: homeassistant/timeshift-btrfs-sync/start
      payload: start_friday_queue
conditions: []
actions:
  - alias: 1. Zotac RI531 backup
    sequence:
      - alias: Power on Zotac using WOL or smart plug
        action: switch.turn_on
        continue_on_error: true
        target:
          entity_id: switch.zotac_ri531_lubuntults
        data: {}
      - alias: Wait for Zotac only if it is currently offline
        if:
          - condition: not
            conditions:
              - condition: device
                type: is_connected
                device_id: 429e6b233c3b269d08222a5073928fb4
                entity_id: 91ac008a7d106ee6ddf4d24f8fe5f1a2
                domain: binary_sensor
        then:
          - alias: Wait up to 20 minutes for Zotac
            wait_for_trigger:
              - trigger: device
                type: connected
                device_id: 429e6b233c3b269d08222a5073928fb4
                entity_id: 91ac008a7d106ee6ddf4d24f8fe5f1a2
                domain: binary_sensor
            timeout: '00:20:00'
            continue_on_timeout: true
      - alias: Run Zotac backup only if Zotac is online
        if:
          - condition: device
            type: is_connected
            device_id: 429e6b233c3b269d08222a5073928fb4
            entity_id: 91ac008a7d106ee6ddf4d24f8fe5f1a2
            domain: binary_sensor
        then:
          - alias: Allow Zotac services to finish starting
            delay:
              hours: 0
              minutes: 5
              seconds: 0
              milliseconds: 0
          - alias: Start Zotac backup
            action: mqtt.publish
            continue_on_error: true
            data:
              evaluate_payload: false
              qos: 0
              retain: false
              topic: homeassistant/mqtt-listener/asusn14e
              payload: timeshift-zotac-ri531
          - alias: Wait for Zotac backup result
            wait_for_trigger:
              - trigger: mqtt
                topic: >-
                  homeassistant/timeshift-btrfs-sync/zotac-ri531-timeshift/status
            timeout: '12:00:00'
            continue_on_timeout: true
          - alias: Read Zotac backup result
            variables:
              backup_status: |-
                {% if wait.trigger is none %}
                  timeout
                {% elif wait.trigger.payload_json is defined %}
                  {{ wait.trigger.payload_json.status
                     | default('unknown')
                     | string
                     | lower }}
                {% else %}
                  {{ wait.trigger.payload
                     | default('unknown')
                     | string
                     | lower }}
                {% endif %}
          - alias: Handle Zotac backup result
            choose:
              - conditions:
                  - condition: template
                    value_template: |-
                      {{ backup_status in
                         ['success', 'successful', 'ok',
                          'complete', 'completed'] }}
                sequence:
                  - alias: Report Zotac backup success
                    action: notify.pushover
                    continue_on_error: true
                    data:
                      title: ✅ Backup completed - Zotac RI531
                      message: |-
                        Zotac RI531 Timeshift backup completed successfully.
                        The queue will continue with the next backup.
                      data:
                        priority: 0
                        sound: pushover
              - conditions:
                  - condition: template
                    value_template: |-
                      {{ backup_status in
                         ['failure', 'failed', 'fail', 'error'] }}
                sequence:
                  - alias: Report Zotac backup failure
                    action: notify.pushover
                    continue_on_error: true
                    data:
                      title: ❌ Backup failed - Zotac RI531
                      message: |-
                        Zotac RI531 reported backup status: {{ backup_status }}.
                        The queue will continue with the next backup.
                      data:
                        priority: 0
                        sound: pushover
              - conditions:
                  - condition: template
                    value_template: '{{ backup_status == ''timeout'' }}'
                sequence:
                  - alias: Report Zotac backup timeout
                    action: notify.pushover
                    continue_on_error: true
                    data:
                      title: ⚠️ Backup timed out - Zotac RI531
                      message: >-
                        Zotac RI531 did not report an MQTT result within 12
                        hours.

                        The queue will continue with the next backup.
                      data:
                        priority: 0
                        sound: pushover
              - conditions:
                  - condition: template
                    value_template: |-
                      {{ backup_status not in
                         ['success', 'successful', 'ok',
                          'complete', 'completed',
                          'failure', 'failed', 'fail', 'error',
                          'timeout'] }}
                sequence:
                  - alias: Report unknown Zotac result
                    action: notify.pushover
                    continue_on_error: true
                    data:
                      title: ⚠️ Unknown backup result - Zotac RI531
                      message: >-
                        Zotac RI531 returned the MQTT status: {{ backup_status
                        }}.

                        The queue will continue with the next backup.
                      data:
                        priority: 0
                        sound: pushover
        else:
          - alias: Report skipped Zotac backup
            action: notify.pushover
            continue_on_error: true
            data:
              title: ⚠️ Backup skipped - Zotac RI531
              message: >-
                Zotac RI531 did not become available within 20 minutes.

                Its backup has been skipped and the queue will continue with the
                next machine.
              data:
                priority: 0
                sound: pushover
      - alias: Delay before next backup
        delay: '00:01:00'
    continue_on_error: true
