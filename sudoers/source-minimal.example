# /etc/sudoers.d/ts-btrfs-source
# Edit with: sudo visudo -f /etc/sudoers.d/ts-btrfs-source
# list-snapshots honors these existing reader permissions and never sudo-runs a shell.
# It can use Timeshift --list for source tags and Btrfs lists for protected paths.
# Per-snapshot Timeshift info.json is read with ordinary non-sudo file access. Ensure
# this user can traverse source.snapshot_root and read each <date>/info.json.
# Do not add a passwordless sudo rule for cat, cp, find, or rm.
ts-btrfs-sync-user ALL=(root) NOPASSWD: /usr/bin/btrfs *
ts-btrfs-sync-user ALL=(root) NOPASSWD: /usr/bin/timeshift *
